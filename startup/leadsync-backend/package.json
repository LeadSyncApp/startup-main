{
  "name": "leadsync-backend",
  "version": "1.0.0",
  "description": "LeadSync Backend API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "ngrok": "ngrok http 4000",
    "dev:all": "concurrently \"npm run dev\" \"npm run ngrok\"",
    "seed": "ts-node -P tsconfig.prisma.json prisma/seed.ts",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "migrate": "npx prisma db push --accept-data-loss",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.97.0",
    "@types/axios": "^0.9.36",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.5",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "openai": "^6.21.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/node-fetch": "^2.6.13",
    "@types/socket.io": "^3.0.1",
    "concurrently": "^9.2.0",
    "prisma": "6.19.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
