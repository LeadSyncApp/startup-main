generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =====================
 * ENUMS
 * =====================
 */

enum ConversationMode {
  BOT
  HUMAN
}

enum Channel {
  WEBSITE
  TELEGRAM
  INSTAGRAM
  WHATSAPP
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum MessageSender {
  CLIENT
  AGENT
  SYSTEM
}


enum OrderStatus {
  BOT_CREATED_ORDER   // 🆕 AI Detected (Hidden)
  PENDING             // Legacy
  NEW                 // Legacy
  CONFIRMED           // Legacy
  PROCESSING          // 🆕 Active (Visible)
  PREPARING           // Legacy
  READY               // Legacy
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  ARCHIVED
}

enum LeadStatus {
    NEW
    CLAIMED
    ARCHIVED
}

enum LeadSegment {
  NEW
  REGULAR
  VIP
  CHURN_RISK
}

enum ConversationIntent {
  BROWSING
  ORDERING
  SUPPORT
  COMPLAINT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  SNOOZED
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderSource {
  MANUAL
  BOT_DETECTED
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id                    String   @id @default(uuid())
  name                  String

  telegramBotToken      String?
  telegramBotUsername   String?
  telegramWebhookSecret String?  @unique
  telegramConnected     Boolean  @default(false)
  
  instagramPageId       String?  @unique
  instagramPageAccessToken String?
  instagramConnected    Boolean  @default(false)

  botWelcomeMessage     String?
  botBusinessType       String?
  botMenu               Json?
  botStructuredMenu     Json?
  botKnowledgeBase      String?
  botLearnedContext     String?

  createdAt             DateTime @default(now())

  users         User[]
  leads         Lead[]
  conversations Conversation[]
  orders        Order[]
}

model User {
  id           String   @id @default(uuid())
  email        String
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  companyId    String
  staffId      String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  processedOrders       Order[]        @relation("ProcessedOrders")
  assignedConversations Conversation[] @relation("AssignedConversations")
  notifications Notification[]

  @@unique([email, companyId])
  @@index([companyId])
  @@index([isActive])
  @@index([createdAt])
}

model Message {
  id             String        @id @default(uuid())
  content        String
  sender         MessageSender
  messageType    String        @default("TEXT")  // TEXT | VOICE | IMAGE | FILE
  conversationId String
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   // ORDER, MESSAGE, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Conversation {
  id         String   @id @default(uuid())
  leadId     String
  companyId  String
  channel    Channel
  mode       ConversationMode @default(BOT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // CRM Fields
  summary        String?
  sentimentScore Int                @default(0)
  intent         ConversationIntent?
  aiHandled      Boolean            @default(true)
  
  // Multi-Agent Fields
  status       ConversationStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?   @relation("AssignedConversations", fields: [assignedToId], references: [id])

  // Optimization
  priorityScore Int @default(0)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]

  @@unique([leadId, companyId, channel], name: "leadId_companyId_channel")
  @@index([companyId, updatedAt])
  @@index([leadId])
  @@index([createdAt])
  @@index([sentimentScore])
  @@index([assignedToId])
  @@index([status])
  @@index([priorityScore])
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  contact   String
  channel   Channel
  companyId String
  createdAt DateTime @default(now())

  status LeadStatus @default(NEW)  // 🆕 Lifecycle Status

  // CRM Fields
  totalSpend   Float       @default(0)
  orderCount   Int         @default(0)
  lastActiveAt DateTime    @default(now())
  segment      LeadSegment @default(NEW)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([contact, channel, companyId])
  @@index([companyId])
  @@index([totalSpend])
  @@index([lastActiveAt])
  @@index([status]) // 🆕 Index for filtering
}

// ... existing models ...

model Order {
  id             String        @id @default(uuid())
  companyId      String
  conversationId String
  leadId         String

  summary  String
  amount   Float        @default(0)
  priority OrderPriority @default(NORMAL)
  status   OrderStatus   @default(BOT_CREATED_ORDER) // 🆕 Default to Ghost Order

  source         OrderSource         @default(MANUAL)
  approvalStatus OrderApprovalStatus @default(APPROVED)

  // CRM / AI Fields
  priorityScore  Int     @default(0) // Calculated score for sorting
  predictedValue Float?              // AI estimated value
  isUrgent       Boolean @default(false)
  
  // Lifecycle Fields
  isDeleted   Boolean   @default(false) // 🆕 Soft Delete
  completedAt DateTime?                 // 🆕 For History Sorting

  processedById String?
  processedBy   User?    @relation("ProcessedOrders", fields: [processedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, approvalStatus])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([conversationId])
  @@index([leadId])
  @@index([processedById])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([priorityScore])
  @@index([completedAt]) // 🆕 Index for History Page
  @@index([isDeleted])   // 🆕 Index for cleanup

  version         Int           @default(1) // Optimistic Locking
  logs            OrderLog[]
}

model OrderLog {
  id          String    @id @default(uuid())
  orderId     String
  
  actorId     String?   // User ID. If null, it's System/Bot
  actorName   String    // "Bot", "Rahul (Agent)" - Denormalized for history speed
  actorRole   String    // "BOT", "AGENT", "OWNER"
  
  action      String    // STATUS_CHANGE, ASSIGNMENT_CHANGE, NOTE_ADDED
  metadata    Json?     // { from: "BOT_DETECTED", to: "CONFIRMED" }
  
  timestamp   DateTime  @default(now())
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([timestamp])
}
