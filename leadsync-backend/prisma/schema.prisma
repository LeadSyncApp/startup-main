enum SourceChannel {
  WEBSITE
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  META
}

enum ConversationIntent {
  BROWSING
  ORDERING
  SUPPORT
  COMPLAINT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  SNOOZED
}

enum ConversationActivityType {
  ASSIGNED
  TRANSFERRED
  RESOLVED
  REOPENED
}

model ConversationActivity {
  id             String                 @id @default(uuid())
  conversationId String
  companyId      String
  type           ConversationActivityType
  actorId        String?
  actorName      String
  fromUserId     String?
  toUserId       String?
  createdAt      DateTime               @default(now())
  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor           User?                  @relation("Activity_actor", fields: [actorId], references: [id])
  fromUser        User?                  @relation("Activity_fromUser", fields: [fromUserId], references: [id])
  toUser          User?                  @relation("Activity_toUser", fields: [toUserId], references: [id])

  @@index([companyId])
  @@index([conversationId])
  @@index([actorId])
}

enum PendingOrderState {
  NONE
  PENDING_APPROVAL
  CLAIMED_FOR_APPROVAL
}

model CompanyPollingLease {
  companyId        String   @id
  holderInstanceId String
  lastHeartbeat    DateTime @default(now())
  expiresAt        DateTime
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([holderInstanceId])
  @@index([holderInstanceId, expiresAt])
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  url       String
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, order])
}

model PriceHistory {
  id         String            @id @default(uuid())
  productId  String
  variantId  String?
  oldPrice   Float
  newPrice   Float
  changedAt  DateTime          @default(now())
  changedBy  String?
  actorName  String            @default("System")
  product    InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    InventoryVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model StockHistory {
  id         String            @id @default(uuid())
  productId  String
  variantId  String?
  oldStock   Int?
  newStock   Int?
  changedAt  DateTime          @default(now())
  changedBy  String?
  actorName  String            @default("System")
  product    InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    InventoryVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

enum DraftOrderStatus {
  DRAFTING
  AWAITING_CONFIRMATION
  CONFIRMED
  ABANDONED
}

model DraftOrder {
  id             String           @id @default(uuid())
  companyId      String
  conversationId String
  leadId         String?
  items          Json
  totalAmount    Float            @default(0.0)
  status         DraftOrderStatus @default(DRAFTING)
  recipientName  String?
  recipientPhone String?
  shippingAddress Json?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@index([conversationId, status])
  @@index([updatedAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  companyId String
  ORDER     Boolean  @default(true)
  MESSAGE   Boolean  @default(true)
  ALERT     Boolean  @default(true)
  SYSTEM    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WebhookDeliveryLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId   String
  platform    String
  outcome     String
  reason      String?
  rawPayload  String?
  rawHeaders  String?
  statusCode  Int?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([outcome])
}

