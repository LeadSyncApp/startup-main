generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                       String                  @id @default(uuid())
  name                     String
  scale                    BusinessScale           @default(HOME_GROWN)
  createdAt                DateTime                @default(now())
  telegramBotToken         String?
  telegramBotTokenHash     String?                 @unique
  telegramBotUsername      String?
  telegramWebhookSecret    String?                 @unique
  telegramConnected        Boolean                 @default(false)
  botBusinessType          String?
  botWelcomeMessage        String?
  businessAddress          String?
  businessName             String?
  companyCode              String                  @unique
  gstin                    String?
  instagramConnected       Boolean                 @default(false)
  instagramPageAccessToken String?
  instagramPageId          String?                 @unique
  whatsAppSystemToken      String?
  whatsAppPhoneNumberId    String?
  invoiceCounter           Int                     @default(0)
  dailyRevenueTarget       Float                   @default(0.0)
  businessStartHour        Int                     @default(8)
  businessEndHour          Int                     @default(22)
  customOooMessage         String                  @default("Hello! Our human team is currently offline. Your message has been pinned right at the top of our workbench queue, and we will message you as soon as our shift begins! ☀️")
  isArchived               Boolean                 @default(false)
  currencySymbol           String                  @default("₹")
  currencyCode             String                  @default("INR")
  timezone                 String                  @default("Asia/Kolkata")
  highValueThreshold       Float                   @default(5000.0)
  bulkItemThreshold        Int                     @default(5)
  upiId                    String?
  upiName                  String?
  updatedAt                DateTime                @updatedAt
  agentFeedPosts           AgentFeedPost[]
  autoReplyLogs            AutoReplyLog[]
  autoReplyRules           AutoReplyRule[]
  automationRules          AutomationRule[]
  botConfiguration         BotConfiguration?
  botKnowledge             BotKnowledge[]
  broadcasts               Broadcast[]
  ClaimLog                 ClaimLog[]
  analyticsRollup          CompanyAnalyticsRollup?
  conversations            Conversation[]
  conversationalRules      ConversationalRule[]
  conversationalRuleLogs   ConversationalRuleLog[]
  customFieldDefinitions   CustomFieldDefinition[]
  invitations              Invitation[]
  invoices                 Invoice[]
  knowledgeChunks          KnowledgeChunk[]
  leads                    Lead[]
  merchantFiles            MerchantFile[]
  Message                  Message[]
  notifications            Notification[]
  notificationTemplates    NotificationTemplate[]
  orders                   Order[]
  orderItems               OrderItem[]
  orderLogs                OrderLog[]
  products                 Product[]
  ruleDecisionLogs         RuleDecisionLog[]
  ruleGroups               RuleGroup[]
  users                    User[]
}

model User {
  id                                           String           @id @default(uuid())
  email                                        String           @unique
  firstName                                    String?
  lastName                                     String?
  passwordHash                                 String?
  role                                         Role             @default(STAFF)
  managerId                                    String?
  companyId                                    String
  createdAt                                    DateTime         @default(now())
  isActive                                     Boolean          @default(true)
  isAvailable                                  Boolean          @default(true)
  staffId                                      String?
  residingAddress                              String?
  phoneNumber                                  String?
  isOnline                                     Boolean          @default(false)
  lastSeenAt                                   DateTime?
  resetToken                                   String?
  resetTokenExpiry                             DateTime?
  updatedAt                                    DateTime         @updatedAt
  authProvider                                 String           @default("EMAIL")
  googleId                                     String?          @unique
  onboardingStatus                             OnboardingStatus @default(PENDING)
  agentFeedPosts                               AgentFeedPost[]  @relation("AgentFeedPosts")
  Conversation_Conversation_assignedToIdToUser Conversation[]   @relation("Conversation_assignedToIdToUser")
  claimedConversations                         Conversation[]   @relation("ClaimedConversations")
  InternalNote                                 InternalNote[]
  sentInvitations                              Invitation[]     @relation("InvitedByUser")
  notifications                                Notification[]
  processedOrders                              Order[]          @relation("ProcessedOrders")
  company                                      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager                                      User?            @relation("UserManagement", fields: [managerId], references: [id])
  subordinates                                 User[]           @relation("UserManagement")

  @@unique([email, companyId])
  @@index([companyId, role])
  @@index([isActive])
  @@index([createdAt])
  @@index([resetToken])
  @@index([managerId])
  @@index([authProvider])
  @@index([googleId])
  @@index([companyId, onboardingStatus])
}

model Lead {
  id                      String            @id @default(uuid())
  name                    String?
  contact                 String
  preferredLanguage       String?
  channel                 Channel
  companyId               String
  createdAt               DateTime          @default(now())
  lastActiveAt            DateTime          @default(now())
  orderCount              Int               @default(0)
  segment                 LeadSegment       @default(NEW)
  status                  LeadStatus        @default(NEW)
  totalSpend              Float             @default(0)
  deletedAt               DateTime?
  pendingOrderAmount      Float?
  pendingOrderClaimedAt   DateTime?
  pendingOrderClaimedById String?
  pendingOrderId          String?
  pendingOrderState       PendingOrderState @default(NONE)
  pendingOrderSummary     String?
  customFields            Json?
  city                    String?
  state                   String?
  tags                    String[]          @default([])
  estimatedValue          Float             @default(0.0)
  aiPriority              AiPriority        @default(LOW)
  isPrivate               Boolean           @default(false)
  conversations           Conversation[]
  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders                  Order[]

  @@unique([contact, channel, companyId])
  @@index([companyId])
  @@index([companyId, aiPriority, estimatedValue])
  @@index([totalSpend])
  @@index([lastActiveAt])
  @@index([status])
  @@index([deletedAt])
  @@index([city])
  @@index([state])
  @@index([tags])
  @@index([pendingOrderClaimedById])
  @@index([pendingOrderState])
}

model Product {
  id             String      @id @default(uuid())
  companyId      String
  sku            String?
  name           String
  description    String?
  price          Float
  cogs           Float?
  stockQuantity  Int         @default(0)
  trackInventory Boolean     @default(false)
  category       String?
  imageUrl       String?
  isActive       Boolean     @default(true)
  attributes     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  brand          String?
  orderItems     OrderItem[]
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sku])
  @@index([companyId])
}

model Order {
  id             String              @id @default(uuid())
  companyId      String
  conversationId String
  leadId         String?
  summary        String
  priority       OrderPriority       @default(NORMAL)
  status         OrderStatus         @default(BOT_CREATED_ORDER)
  sourceChannel  SourceChannel       @default(WEBSITE)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  amount         Float               @default(0)
  totalCogs      Float               @default(0)
  netProfit      Float               @default(0)
  processedById  String?
  approvalStatus OrderApprovalStatus @default(APPROVED)
  source         OrderSource         @default(MANUAL)
  completedAt    DateTime?
  isDeleted      Boolean             @default(false)
  isUrgent       Boolean             @default(false)
  predictedValue Float?
  priorityScore  Int                 @default(0)
  version        Int                 @default(1)
  invoice        Invoice?
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead           Lead?               @relation(fields: [leadId], references: [id])
  processedBy    User?               @relation("ProcessedOrders", fields: [processedById], references: [id])
  orderItems     OrderItem[]
  logs           OrderLog[]

  @@index([companyId])
  @@index([companyId, approvalStatus])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, sourceChannel])
  @@index([companyId, amount])
  @@index([leadId])
  @@index([processedById])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([priorityScore])
  @@index([completedAt])
  @@index([conversationId])
  @@index([isDeleted])
}

model CompanyAnalyticsRollup {
  id               String   @id @default(uuid())
  companyId        String   @unique
  totalRevenue     Float    @default(0.0)
  totalOrdersCount Int      @default(0)
  totalLeadsCount  Int      @default(0)
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String   @id @default(uuid())
  companyId String
  orderId   String
  productId String?
  sku       String?
  name      String
  quantity  Int
  price     Float
  cogs      Float?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([orderId])
  @@index([productId])
  @@index([sku])
}

model OrderLog {
  id        String   @id @default(uuid())
  companyId String
  orderId   String
  actorId   String?
  actorName String
  actorRole String
  action    String
  metadata  Json?
  timestamp DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
  @@index([timestamp])
}

model Invoice {
  id              String   @id @default(uuid())
  companyId       String
  orderId         String   @unique
  invoiceNumber   String
  invoiceDate     DateTime @default(now())
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  currency        String   @default("USD")
  paymentStatus   String
  paymentProvider String   @default("razorpay")
  paymentRef      String?
  pdfUrl          String?
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([companyId, invoiceNumber])
}

model Conversation {
  id                                   String              @id @default(uuid())
  channel                              Channel
  leadId                               String?
  createdAt                            DateTime            @default(now())
  companyId                            String
  mode                                 ConversationMode    @default(BOT)
  updatedAt                            DateTime            @updatedAt
  aiHandled                            Boolean             @default(true)
  aiSummary                            String?
  aiSummaryAt                          DateTime?
  latestSummary                        String?
  suggestedAgentReply                  String?
  transientIntentState                 String?
  assignedToId                         String?
  intent                               ConversationIntent?
  priorityScore                        Int                 @default(0)
  sentimentScore                       Int                 @default(0)
  sessionState                         Json?
  status                               ConversationStatus  @default(OPEN)
  summary                              String?
  claimedById                          String?
  claimExpiresAt                       DateTime?
  lastClaimHeartbeat                   DateTime?
  lastViewedAt                         DateTime?
  deletedAt                            DateTime?
  lifecycleStatus                      String              @default("active")
  archivedAt                           DateTime?
  resolutionNote                       String?
  isReturningCustomer                  Boolean             @default(false)
  claimedAt                            DateTime?
  needsStaffReason                     String?
  claimedByName                        String?
  previousHandledById                  String?
  previousConversationId               String?
  claimLogs                            ClaimLog[]
  User_Conversation_assignedToIdToUser User?               @relation("Conversation_assignedToIdToUser", fields: [assignedToId], references: [id])
  claimedBy                            User?               @relation("ClaimedConversations", fields: [claimedById], references: [id])
  company                              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead                                 Lead?               @relation(fields: [leadId], references: [id])
  internalNotes                        InternalNote[]
  messages                             Message[]
  orders                               Order[]
  RuleDecisionLog                      RuleDecisionLog[]

  @@index([deletedAt])
  @@index([leadId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([assignedToId])
  @@index([claimExpiresAt])
  @@index([claimedById])
  @@index([companyId, updatedAt])
  @@index([leadId, companyId, channel])
  @@index([leadId, lifecycleStatus])
  @@index([lifecycleStatus])
  @@index([priorityScore])
  @@index([sentimentScore])
  @@index([status])
}

model Message {
  id                String        @id @default(uuid())
  companyId         String
  content           String
  sender            MessageSender
  conversationId    String
  createdAt         DateTime      @default(now())
  messageType       String        @default("TEXT")
  platform          Channel?
  externalMessageId String?
  deliveryStatus    String?       @default("SENT")
  senderName        String?
  senderId          String?
  isRead            Boolean       @default(false)
  deliveryError     String?
  clientMessageId   String?
  Company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([platform, externalMessageId])
  @@index([conversationId, isRead])
  @@index([companyId])
  @@index([conversationId, createdAt])
}

model BotKnowledge {
  id        String   @id @default(uuid())
  companyId String
  type      String   @default("FAQ")
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
}

model AutomationRule {
  id                  String          @id @default(uuid())
  companyId           String
  name                String
  isActive            Boolean         @default(true)
  trigger             String
  triggerDelayMinutes Int             @default(1440)
  action              String
  actionPayload       Json?
  runCount            Int             @default(0)
  lastRunAt           DateTime?
  createdAt           DateTime        @default(now())
  logs                AutomationLog[]
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, isActive])
}

model AutomationLog {
  id           String         @id @default(uuid())
  ruleId       String
  companyId    String
  triggeredFor String
  action       String
  result       String
  note         String?
  createdAt    DateTime       @default(now())
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([companyId])
  @@index([createdAt])
}

model AutoReplyRule {
  id             String         @id @default(uuid())
  companyId      String
  eventKey       String
  isEnabled      Boolean        @default(true)
  messageBody    String
  delayMinutes   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  useAI          Boolean        @default(false)
  brandVoice     String?        @default("friendly")
  targetLanguage String?        @default("en")
  logs           AutoReplyLog[]
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, eventKey])
  @@index([companyId])
  @@index([eventKey])
  @@index([isEnabled])
}

model AutoReplyLog {
  id           String         @id @default(uuid())
  companyId    String
  ruleId       String?
  eventKey     String
  triggeredFor String
  recipient    String
  channel      String
  messageBody  String
  status       String         @default("SENT")
  error        String?
  sentAt       DateTime       @default(now())
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule         AutoReplyRule? @relation(fields: [ruleId], references: [id])

  @@index([companyId])
  @@index([ruleId])
  @@index([sentAt])
  @@index([status])
}

model RuleGroup {
  id          String               @id @default(uuid())
  companyId   String
  name        String
  description String?
  type        String               @default("AI_INSTRUCTION")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  rules       ConversationalRule[]
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, type])
}

model ConversationalRule {
  id              String                  @id @default(uuid())
  companyId       String
  name            String
  isEnabled       Boolean                 @default(true)
  triggerKeywords String[]                @default([])
  triggerType     String                  @default("KEYWORD")
  conditions      Json?
  templateBody    String                  @default("")
  useAI           Boolean                 @default(false)
  brandVoice      String?                 @default("friendly")
  targetLanguage  String?                 @default("auto")
  sourcePrompt    String?
  triggerCount    Int                     @default(0)
  lastTriggeredAt DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  groupId         String?
  hourRange       Json?
  dateRange       Json?
  ruleType        Int                     @default(1)
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group           RuleGroup?              @relation(fields: [groupId], references: [id])
  logs            ConversationalRuleLog[]
  RuleDecisionLog RuleDecisionLog[]

  @@index([companyId])
  @@index([companyId, isEnabled])
  @@index([triggerKeywords])
  @@index([groupId])
  @@index([companyId, ruleType])
  @@index([dateRange], type: Gin)
  @@index([hourRange], type: Gin)
}

model ConversationalRuleLog {
  id             String             @id @default(uuid())
  companyId      String
  ruleId         String
  conversationId String?
  leadId         String?
  inboundText    String
  responseSent   String?
  matchedKeyword String?
  aiGenerated    Boolean            @default(false)
  status         String             @default("TRIGGERED")
  error          String?
  createdAt      DateTime           @default(now())
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule           ConversationalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([ruleId])
  @@index([createdAt])
  @@index([status])
}

model RuleDecisionLog {
  id                 String              @id @default(uuid())
  companyId          String
  conversationId     String?
  messageText        String
  topScore           Float?
  secondScore        Float?
  gap                Float?
  pathTaken          String
  matchedRuleId      String?
  createdAt          DateTime            @default(now())
  blockedReason      String?
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Conversation       Conversation?       @relation(fields: [conversationId], references: [id], onUpdate: NoAction)
  ConversationalRule ConversationalRule? @relation(fields: [matchedRuleId], references: [id], onUpdate: NoAction)

  @@index([companyId])
  @@index([companyId, pathTaken])
  @@index([matchedRuleId])
  @@index([createdAt])
}

model AgentFeedPost {
  id        String   @id @default(uuid())
  companyId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation("AgentFeedPosts", fields: [authorId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([userId, isRead])
}

model BotConfiguration {
  id                String   @id @default(uuid())
  companyId         String   @unique
  botMenu           Json?
  botStructuredMenu Json?
  botCommands       Json?
  botKnowledgeBase  String?
  botLearnedContext String?
  botPolicies       String?  @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model MerchantFile {
  id        String   @id @default(uuid())
  companyId String
  fileUrl   String?
  fileName  String?
  status    String   @default("PROCESSING")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model KnowledgeChunk {
  id         String                 @id @default(uuid())
  companyId  String
  sourceType KnowledgeSourceType
  sourceId   String?
  content    String
  embedding  Unsupported("vector")?
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceType, sourceId])
  @@index([companyId])
  @@index([companyId, isActive])
}

model NotificationTemplate {
  id                 String   @id @default(uuid())
  companyId          String
  keyIdentifier      String
  localeCode         String
  templateBodyString String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, keyIdentifier, localeCode])
  @@index([companyId])
  @@index([keyIdentifier])
}

model CustomFieldDefinition {
  id           String   @id @default(uuid())
  companyId    String
  module       String
  name         String
  label        String
  type         String
  required     Boolean  @default(false)
  options      Json?
  defaultValue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module, name])
  @@index([companyId])
  @@index([companyId, module])
}

model Invitation {
  id              String           @id @default(uuid())
  companyId       String
  invitedByUserId String?
  email           String
  role            Role
  status          InvitationStatus @default(PENDING)
  token           String           @unique
  tokenLookup     String?          @unique
  staffId         String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  message         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@index([companyId])
  @@index([token])
  @@index([tokenLookup])
  @@index([email])
  @@index([status])
  @@index([status, tokenLookup])
}

model IncomingWebhook {
  id          String    @id @default(cuid())
  provider    String
  companyId   String
  externalId  String?
  payload     Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([status, createdAt])
}

model Idempotency {
  key       String            @id
  status    IdempotencyStatus @default(PROCESSING)
  result    Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  expiresAt DateTime

  @@index([expiresAt])
  @@index([status, updatedAt])
}

model Broadcast {
  id             String        @id @default(cuid())
  companyId      String
  title          String?
  message        String
  targetTags     String[]
  targetSegments LeadSegment[]
  recipientCount Int           @default(0)
  status         String        @default("SENT")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Represents the official India Post master postal database index (~155,000 records).
model PostalPincodeIndex {
  id        String   @id @default(uuid())
  pincode   String   @unique
  state     String
  district  String
  region    String?
  createdAt DateTime @default(now())

  @@index([pincode])
}

model ClaimLog {
  id             String       @id
  companyId      String
  conversationId String
  actorId        String?
  actorName      String
  action         String
  createdAt      DateTime     @default(now())
  Company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([conversationId])
  @@index([createdAt])
}

model InternalNote {
  id             String       @id
  conversationId String
  companyId      String
  authorId       String?
  authorName     String
  content        String
  mentionedIds   Json?
  createdAt      DateTime     @default(now())
  User           User?        @relation(fields: [authorId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([conversationId])
}

model socket_io_attachments {
  id         BigInt    @unique @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  payload    Bytes?
}

enum KnowledgeSourceType {
  RULE
  PRODUCT
  POLICY
  MANUAL
}

