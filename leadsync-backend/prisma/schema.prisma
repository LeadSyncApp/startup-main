generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                       String           @id @default(uuid())
  name                     String
  createdAt                DateTime         @default(now())
  telegramBotToken         String?
  telegramBotUsername      String?
  telegramWebhookSecret    String?          @unique
  telegramConnected        Boolean          @default(false)
  botBusinessType          String?
  botMenu                  Json?
  botWelcomeMessage        String?
  botStructuredMenu        Json?
  botKnowledgeBase         String?
  botLearnedContext        String?
  botPolicies              String?          @default("")
  businessAddress          String?
  businessName             String?
  gstin                    String?
  instagramConnected       Boolean          @default(false)
  instagramPageAccessToken String?
  instagramPageId          String?          @unique
  invoiceCounter           Int              @default(0)
  assignmentStrategy       String?          @default("MANUAL")
  automationRules          AutomationRule[]
  botKnowledge             BotKnowledge[]
  broadcasts               Broadcast[]
  conversations            Conversation[]
  invoices                 Invoice[]
  leads                    Lead[]
  orders                   Order[]
  users                    User[]
}

model Invoice {
  id              String   @id @default(uuid())
  companyId       String
  orderId         String   @unique
  invoiceNumber   String
  invoiceDate     DateTime @default(now())
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  currency        String   @default("INR")
  paymentStatus   String
  paymentProvider String   @default("razorpay")
  paymentRef      String?
  pdfUrl          String?
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([companyId, invoiceNumber])
}

model User {
  id                    String         @id @default(uuid())
  email                 String
  name                  String
  passwordHash          String
  role                  Role           @default(AGENT)
  companyId             String
  createdAt             DateTime       @default(now())
  isActive              Boolean        @default(true)
  isAvailable           Boolean        @default(true)
  staffId               String?
  resetToken            String?
  resetTokenExpiry      DateTime?
  assignedConversations Conversation[] @relation("AssignedConversations")
  internalNotes         InternalNote[] @relation("InternalNotes")
  notifications         Notification[]
  processedOrders       Order[]        @relation("ProcessedOrders")
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([email, companyId])
  @@index([companyId])
  @@index([isActive])
  @@index([createdAt])
  @@index([resetToken])
}

model Message {
  id             String        @id @default(uuid())
  content        String
  sender         MessageSender
  conversationId String
  createdAt      DateTime      @default(now())
  messageType    String        @default("TEXT")
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Conversation {
  id             String              @id @default(uuid())
  channel        Channel
  leadId         String
  createdAt      DateTime            @default(now())
  companyId      String
  mode           ConversationMode    @default(BOT)
  updatedAt      DateTime            @updatedAt
  aiHandled      Boolean             @default(true)
  aiSummary      String?
  aiSummaryAt    DateTime?
  assignedToId   String?
  intent         ConversationIntent?
  priorityScore  Int                 @default(0)
  sentimentScore Int                 @default(0)
  sessionState   Json?
  status         ConversationStatus  @default(OPEN)
  summary        String?
  assignedTo     User?               @relation("AssignedConversations", fields: [assignedToId], references: [id])
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  internalNotes  InternalNote[]
  messages       Message[]
  orders         Order[]

  @@unique([leadId, companyId, channel], name: "leadId_companyId_channel")
  @@index([companyId, updatedAt])
  @@index([leadId])
  @@index([createdAt])
  @@index([sentimentScore])
  @@index([assignedToId])
  @@index([status])
  @@index([priorityScore])
}

model Lead {
  id                      String            @id @default(uuid())
  name                    String?
  contact                 String
  channel                 Channel
  companyId               String
  createdAt               DateTime          @default(now())
  lastActiveAt            DateTime          @default(now())
  orderCount              Int               @default(0)
  segment                 LeadSegment       @default(NEW)
  status                  LeadStatus        @default(NEW)
  totalSpend              Float             @default(0)
  deletedAt               DateTime?
  pendingOrderAmount      Float?
  pendingOrderClaimedAt   DateTime?
  pendingOrderClaimedById String?
  pendingOrderId          String?
  pendingOrderState       PendingOrderState @default(NONE)
  pendingOrderSummary     String?
  conversations           Conversation[]
  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders                  Order[]

  @@unique([contact, channel, companyId])
  @@index([companyId])
  @@index([totalSpend])
  @@index([lastActiveAt])
  @@index([status])
  @@index([pendingOrderState])
  @@index([pendingOrderClaimedById])
  @@index([deletedAt])
}

model Order {
  id             String              @id @default(uuid())
  companyId      String
  conversationId String
  leadId         String
  summary        String
  priority       OrderPriority       @default(NORMAL)
  status         OrderStatus         @default(BOT_CREATED_ORDER)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  amount         Float               @default(0)
  processedById  String?
  approvalStatus OrderApprovalStatus @default(APPROVED)
  source         OrderSource         @default(MANUAL)
  completedAt    DateTime?
  isDeleted      Boolean             @default(false)
  isUrgent       Boolean             @default(false)
  items          Json?
  predictedValue Float?
  priorityScore  Int                 @default(0)
  version        Int                 @default(1)
  invoice        Invoice?
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  processedBy    User?               @relation("ProcessedOrders", fields: [processedById], references: [id])
  logs           OrderLog[]

  @@index([companyId])
  @@index([companyId, approvalStatus])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([conversationId])
  @@index([leadId])
  @@index([processedById])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([priorityScore])
  @@index([completedAt])
  @@index([isDeleted])
}

model Broadcast {
  id            String    @id @default(uuid())
  companyId     String
  message       String
  channel       Channel
  targetSegment String
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model OrderLog {
  id        String   @id @default(uuid())
  orderId   String
  actorId   String?
  actorName String
  actorRole String
  action    String
  metadata  Json?
  timestamp DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
}

model BotKnowledge {
  id        String   @id @default(uuid())
  companyId String
  type      String   @default("FAQ")
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
}

model AutomationRule {
  id                  String          @id @default(uuid())
  companyId           String
  name                String
  isActive            Boolean         @default(true)
  trigger             String
  triggerDelayMinutes Int             @default(1440)
  action              String
  actionPayload       Json?
  runCount            Int             @default(0)
  lastRunAt           DateTime?
  createdAt           DateTime        @default(now())
  logs                AutomationLog[]
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
}

model AutomationLog {
  id           String         @id @default(uuid())
  ruleId       String
  companyId    String
  triggeredFor String
  action       String
  result       String
  note         String?
  createdAt    DateTime       @default(now())
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([companyId])
}

model InternalNote {
  id             String       @id @default(uuid())
  conversationId String
  companyId      String
  authorId       String
  authorName     String
  content        String
  mentionedIds   Json?
  createdAt      DateTime     @default(now())
  author         User         @relation("InternalNotes", fields: [authorId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([companyId])
}

model AgentChatHistoryClear {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  companyId String
  clearedAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([companyId])
}

enum ConversationMode {
  BOT
  HUMAN
}

enum Channel {
  WEBSITE
  TELEGRAM
  WHATSAPP
  INSTAGRAM
}

enum Role {
  OWNER
  AGENT
  ADMIN
}

enum MessageSender {
  CLIENT
  AGENT
  SYSTEM
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
  BOT_CREATED_ORDER
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  REJECTED
  ARCHIVED
  USER_CONFIRMED_PENDING_AGENT
}

enum LeadStatus {
  NEW
  CLAIMED
  ARCHIVED
}

enum PendingOrderState {
  NONE
  PENDING_APPROVAL
  CLAIMED_FOR_APPROVAL
}

enum LeadSegment {
  NEW
  REGULAR
  VIP
  CHURN_RISK
}

enum ConversationIntent {
  BROWSING
  ORDERING
  SUPPORT
  COMPLAINT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  SNOOZED
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderSource {
  MANUAL
  BOT_DETECTED
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
