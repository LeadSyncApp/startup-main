generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =====================
 * ENUMS
 * =====================
 */

enum ConversationMode {
  BOT
  HUMAN
}

enum Channel {
  WEBSITE
  TELEGRAM
  WHATSAPP
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum MessageSender {
  CLIENT
  AGENT
  SYSTEM
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderSource {
  MANUAL
  BOT_DETECTED
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * =====================
 * MODELS
 * =====================
 */

model Company {
  id                    String   @id @default(uuid())
  name                  String

  telegramBotToken      String?
  telegramBotUsername   String?
  telegramWebhookSecret String?  @unique
  telegramConnected     Boolean  @default(false)

  botWelcomeMessage     String?
  botBusinessType       String?
  botMenu               Json?
  botStructuredMenu     Json?

  createdAt             DateTime @default(now())

  users         User[]
  leads         Lead[]
  conversations Conversation[]
  orders        Order[]
}
model User {
  id           String   @id @default(uuid())
  email        String
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  companyId    String
  staffId      String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  processedOrders Order[] @relation("ProcessedOrders")

  @@unique([email, companyId])
  @@index([companyId])
  @@index([isActive])
  @@index([createdAt])
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  contact   String
  channel   Channel
  companyId String
  createdAt DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([contact, channel, companyId])
  @@index([companyId])
}

model Conversation {
  id         String   @id @default(uuid())
  leadId     String
  companyId  String
  channel    Channel
  mode       ConversationMode @default(BOT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]

  @@unique([leadId, companyId, channel], name: "leadId_companyId_channel")
  @@index([companyId, updatedAt])
  @@index([leadId])
  @@index([createdAt])
}

model Message {
  id             String        @id @default(uuid())
  content        String
  sender         MessageSender
  conversationId String
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId])
}

model Order {
  id             String        @id @default(uuid())
  companyId      String
  conversationId String
  leadId         String

  summary  String
  amount   Float        @default(0)
  priority OrderPriority @default(NORMAL)
  status   OrderStatus   @default(NEW)

  source         OrderSource         @default(MANUAL)
  approvalStatus OrderApprovalStatus @default(APPROVED)

  processedById String?
  processedBy   User?    @relation("ProcessedOrders", fields: [processedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, approvalStatus])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([conversationId])
  @@index([leadId])
  @@index([processedById])
  @@index([approvalStatus])
  @@index([createdAt])
}
