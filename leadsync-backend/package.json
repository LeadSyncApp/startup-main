{
  "name": "leadsync-backend",
  "version": "1.0.0",
  "description": "LeadSync Backend API",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "npm run db:client && ts-node-dev --respawn --transpile-only src/server.ts",
    "ngrok": "ngrok http 4000",
    "dev:all": "concurrently \"npm run dev\" \"npm run ngrok\"",
    "seed": "ts-node -P tsconfig.prisma.json prisma/seed.ts",
    "build": "npm run db:client && tsc",
    "start": "npm run db:client && node dist/server.js",
    "migrate": "prisma migrate deploy",
    "db:client": "powershell -ExecutionPolicy Bypass -File ./scripts/db-client.ps1",
    "postinstall": "powershell -ExecutionPolicy Bypass -File ./scripts/db-client.ps1",
    "repo:map": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-repo-map.ps1"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.2",
    "@socket.io/postgres-adapter": "^0.3.1",
    "@supabase/supabase-js": "^2.97.0",
    "@types/axios": "^0.9.36",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.11.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "exceljs": "^3.4.0",
    "express": "^4.22.1",
    "express-limit": "^1.0.0",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.21.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pg-boss": "^10.1.3",
    "pino": "^9.2.0",
    "razorpay": "^2.9.6",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/node-fetch": "^2.6.13",
    "@types/socket.io": "^3.0.1",
    "concurrently": "^9.2.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
